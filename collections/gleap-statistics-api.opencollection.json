              },
              {
                "name": "timezone",
                "value": "",
                "type": "query",
                "description": "- Timezone for date calculations (e.g., \"America/New_York\")"
              },
              {
                "name": "groupInterval",
                "value": "",
                "type": "query",
                "description": "- Grouping interval (\"day\", \"month\", \"year\")"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "groupedBy",
                "value": "",
                "type": "query"
              },
              {
                "name": "aggsType",
                "value": "",
                "type": "query",
                "description": "- Aggregation type (\"MEDIAN\", \"AVERAGE\")"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "- Start date for filtering (ISO format)"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "- End date for filtering (ISO format)"
              },
              {
                "name": "createdAt",
                "value": "",
                "type": "query"
              },
              {
                "name": "updatedAt",
                "value": "",
