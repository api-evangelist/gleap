          },
          "http": {
            "method": "GET",
            "url": "https://api.gleap.io/v3/translations/entries",
            "headers": [
              {
                "name": "project",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all translatable entries"
        },
        {
          "info": {
            "name": "Get a single translatable entry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gleap.io/v3/translations/entries/:entryId",
            "headers": [
              {
                "name": "project",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entryId",
                "value": "",
                "type": "path"
              },
              {
                "name": "language",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a single translatable entry"
        },
        {
          "info": {
            "name": "Update a translatable entry",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.gleap.io/v3/translations/entries/:entryId",
            "headers": [
              {
                "name": "project",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entryId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a translatable entry"
        }
      ]
    }
  ],
  "bundled": true
}